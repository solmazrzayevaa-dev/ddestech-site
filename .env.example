# DesTech landing — mühit dəyişənləri
# Bu faylı `.env.local` kimi kopyala və dəyərləri doldur.
# `.env*` .gitignore-dadır — real açarları commit etmə.

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role
# DİQQƏT: bu açar RLS-i bypass edir. YALNIZ serverdə işlənir —
# adına NEXT_PUBLIC_ əlavə ETMƏ, əks halda brauzerə sızar.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Creator qeydiyyat formu (brauzerdən birbaşa Supabase-ə) ──────────────
# Yuxarıdakı SUPABASE_URL ilə eyni dəyər, amma brauzerə düşdüyü üçün
# NEXT_PUBLIC_ prefiksi ilə ayrıca təyin olunur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → "Publishable and secret API keys"
# tabı → Publishable key (`sb_publishable_…` ilə başlayır).
#
# DİQQƏT: "Legacy anon, service_role API keys" tabındakı köhnə `eyJhbGci…`
# açarları bu layihədə söndürülüb — onları işlətsən Supabase 401 qaytarır.
#
# Bu açarın brauzerdə görünməsi NORMALDIR: RLS (0002_ai_creator_registrations.sql)
# ona yalnız `insert` icazəsi verir. `sb_secret_…` açarını BURAYA YAZMA.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── DesTech platform (admin app) ────────────────────────────────────────────
# Müraciətlər paralel olaraq platformun Supabase layihəsinə də yazılır ki,
# komanda onları platformun `/leads` səhifəsində cədvəl kimi görsün.
# destechplatform-un Supabase layihəsi → Project Settings → Data API
# Boş qalsa köçürmə baş tutmur — əsas bazaya yazma pozulmur.
PLATFORM_SUPABASE_URL=

# Həmin layihənin service_role açarı. RLS-i bypass edir — YALNIZ serverdə,
# NEXT_PUBLIC_ prefiksi ƏLAVƏ ETMƏ.
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=

# ── Sayt ünvanı ─────────────────────────────────────────────────────────────
# Kanonik URL — metadata, OG, robots.txt və sitemap.xml üçün.
# Vercel-də təyin olunmasa, deploy-un öz domeni işlədilir.
NEXT_PUBLIC_SITE_URL=https://destech.az

# ── Analitika (opsional) ────────────────────────────────────────────────────
# Boş qalsa skriptlər ümumiyyətlə yüklənmir.
# GA4: Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_ID=

# Meta Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
